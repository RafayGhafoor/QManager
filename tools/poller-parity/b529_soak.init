#!/bin/sh /etc/rc.common
# b529_soak: procd service for the B5.29 soak daemon (dev-only; never part of
# the QManager package). Installed to /etc/init.d/b529_soak by
# tools/poller-parity/soak_install.sh. Everything else, including the log and
# the progress state, lives on /usrdata/b529_mon so a reboot resumes the soak.
#
# Remove: /etc/init.d/b529_soak stop; /etc/init.d/b529_soak disable;
#         rm -f /etc/init.d/b529_soak; rm -rf /usrdata/b529_mon

START=99
STOP=05
USE_PROCD=1

DIR=/usrdata/b529_mon

start_service() {
    [ -f "$DIR/bin/soakd.sh" ] || return 0
    [ -f "$DIR/done" ] && return 0

    procd_open_instance soak
    procd_set_param command /bin/sh "$DIR/bin/soakd.sh"
    # Respawn after 30 s, no retry limit: the daemon only exits on a fault.
    procd_set_param respawn 3600 30 0
    procd_set_param stdout 0
    procd_set_param stderr 1
    procd_close_instance
}
