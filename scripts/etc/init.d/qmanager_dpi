#!/bin/sh /etc/rc.common
# qmanager_dpi — DPI evasion service
# Runs ONE engine in one of two modes:
#   Video Optimizer (hostlist desync) OR Traffic Masquerade (fake SNI on all traffic)
# Mutually exclusive — only one mode can be active at a time.
#
# Two engines, see /usr/lib/qmanager/dpi_helper.sh:
#   nfqws — packet-queue engine (needs NFQUEUE); also the only engine that can do
#           Masquerade, so Masquerade always selects it whatever the saved choice.
#   tpws  — redirect engine for Video Optimizer; no NFQUEUE needed.
#
# The redirect engine's iptables rules are added and removed by its supervisor
# (/usr/bin/qmanager_dpi_tpws) around the listener, and removed again here in
# stop_service — rc.common runs stop_service BEFORE procd kills the instance, so
# the rules always go before the process that serves them.

START=99
STOP=10
USE_PROCD=1

. /usr/lib/qmanager/qlog.sh
. /usr/lib/qmanager/dpi_helper.sh

qlog_init "qmanager_dpi"

start_service() {
    local vo_enabled
    local masq_enabled
    local engine

    # Determine which mode is active (mutually exclusive)
    vo_enabled=$(uci -q get quecmanager.video_optimizer.enabled)
    masq_enabled=$(uci -q get quecmanager.traffic_masquerade.enabled)

    # Neither enabled — nothing to do
    [ "$vo_enabled" = "1" ] || [ "$masq_enabled" = "1" ] || return 0

    if [ "$masq_enabled" = "1" ]; then
        engine="$DPI_ENGINE_NFQWS"
    else
        engine=$(dpi_vo_engine)
    fi

    # Shared prerequisite checks
    if ! dpi_check_engine_binary "$engine"; then
        qlog_error "$engine binary not found"
        return 1
    fi

    # The packet queue is the packet-queue engine's requirement only; the
    # redirect engine must start on a kernel that has none.
    if [ "$engine" = "$DPI_ENGINE_NFQWS" ] && ! dpi_check_kmod; then
        qlog_error "Failed to load nfnetlink_queue kernel module"
        return 1
    fi

    local args="--qnum=$DPI_QUEUE_NUM"

    if [ "$masq_enabled" = "1" ]; then
        # --- Traffic Masquerade mode ---
        local sni_domain
        sni_domain=$(uci -q get quecmanager.traffic_masquerade.sni_domain)
        sni_domain="${sni_domain:-speedtest.net}"

        args="$args --dpi-desync=fake"
        args="$args --dpi-desync-fake-tls-mod=sni=$sni_domain"
        args="$args --dpi-desync-fooling=badseq"
        args="$args --dpi-desync-udplen-increment=2"
        args="$args --dpi-desync-repeats=2"

        qlog_info "Starting traffic masquerade (sni=$sni_domain, repeats=2)"

    elif [ "$vo_enabled" = "1" ]; then
        # --- Video Optimizer mode ---
        if [ "$engine" = "$DPI_ENGINE_TPWS" ]; then
            # The redirect engine builds its own command line (dpi_tpws_args)
            # and owns the iptables rules; this instance is its supervisor, so
            # there is nothing to pass and no queue to address.
            qlog_info "Starting video optimizer on the redirect engine"
            procd_open_instance "$DPI_ENGINE_TPWS"
            procd_set_param command /usr/bin/qmanager_dpi_tpws
            procd_set_param respawn 3600 5 5
            procd_set_param stdout 1
            procd_set_param stderr 1
            procd_set_param pidfile "$TPWS_PID"
            procd_close_instance
            qlog_info "DPI service started"
            return 0
        fi

        if [ ! -f "$DPI_HOSTLIST" ]; then
            qlog_error "Hostname list not found at $DPI_HOSTLIST"
            return 1
        fi

        local quic_enabled desync_repeats
        quic_enabled=$(uci -q get quecmanager.video_optimizer.quic_enabled)
        desync_repeats=$(uci -q get quecmanager.video_optimizer.desync_repeats)

        # Clamp desync_repeats to [1,10]; fall back to 1 on non-numeric or out-of-range
        case "$desync_repeats" in
            ''|*[!0-9]*) desync_repeats=1 ;;
            *)
                if [ "$desync_repeats" -lt 1 ] || [ "$desync_repeats" -gt 10 ]; then
                    desync_repeats=1
                fi
                ;;
        esac

        args="$args --hostlist=$DPI_HOSTLIST"
        args="$args --dpi-desync=split2"
        args="$args --dpi-desync-split-seqovl=1"
        args="$args --dpi-desync-split-pos=1"

        if [ "$desync_repeats" -gt 1 ]; then
            args="$args --dpi-desync-repeats=$desync_repeats"
        fi

        if [ "$quic_enabled" != "0" ]; then
            args="$args --dpi-desync-udplen-increment=2"
        fi

        qlog_info "Starting video optimizer (repeats=$desync_repeats)"
    fi

    procd_open_instance "$engine"
    procd_set_param command $NFQWS_BIN $args
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    # procd spawns the instance only after start_service returns, so a
    # pidof here always ran too early and left the pidfile empty. procd
    # writes the pidfile itself on every (re)spawn; dpi_get_uptime uses
    # its mtime and dpi_get_status gates on it via qm_read_pid.
    procd_set_param pidfile "$NFQWS_PID"
    procd_close_instance

    qlog_info "DPI service started"
}

stop_service() {
    qlog_info "Stopping DPI service"
    # Belt to the supervisor's braces: rc.common runs stop_service before procd
    # kills the instance, so the redirect rules are gone BEFORE the process that
    # serves them. A supervisor killed with SIGKILL (trap starved) is caught
    # here too. Idempotent, and a no-op when the packet-queue engine is running.
    dpi_tpws_rules_remove
    rm -f "$NFQWS_PID" "$TPWS_PID"
}

service_triggers() {
    procd_add_reload_trigger "quecmanager"
}
