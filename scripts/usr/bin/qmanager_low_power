#!/bin/sh
# =============================================================================
# qmanager_low_power — Low Power Mode Toggle
# =============================================================================
# Called by cron to enter or exit low power mode. Disables or re-enables the
# modem radio via AT+CFUN and manages state flags for the poller and watchdog.
#
# Usage: /usr/bin/qmanager_low_power enter|exit
#
# Install location: /usr/bin/qmanager_low_power
# =============================================================================

case "$1" in
    enter|exit) ;;
    *) echo "Usage: $0 enter|exit" >&2; exit 1 ;;
esac

# Guarded with -f: BusyBox ash exits when `.` cannot find its file.
if [ -f /usr/lib/qmanager/qlog.sh ]; then
    . /usr/lib/qmanager/qlog.sh
else
    qlog_init() { :; }
    qlog_info() { logger -t low_power "$1"; }
fi

qlog_init "low_power"

STATE_FILE="/tmp/qmanager_low_power_active"
WATCHCAT_LOCK="/tmp/qmanager_watchcat.lock"

if [ "$1" = "enter" ]; then
    # Clock-step guard (issue #9): crond runs a job whose minute a boot-time
    # clock step crosses, and a misfired enter cuts the radio until the exit
    # time. Exit stays unguarded: restoring the radio is the safe direction.
    if [ -f /usr/lib/qmanager/schedule_guard.sh ]; then
        . /usr/lib/qmanager/schedule_guard.sh
        lp_start=$(uci -q get quecmanager.settings.low_power_start 2>/dev/null)
        lp_days=$(uci -q get quecmanager.settings.low_power_days 2>/dev/null)
        if ! _qm_validate_hhmm "$lp_start"; then
            qlog_info "Low power enter skipped: start time unreadable ('$lp_start')"
            exit 0
        fi
        if ! _qm_timer_fire_allowed "$lp_start" "$lp_days"; then
            qlog_info "Low power enter skipped: $QM_GUARD_REASON (clock-step guard)"
            exit 0
        fi
    else
        qlog_info "Low power enter skipped: schedule_guard.sh missing, failing closed"
        exit 0
    fi

    qlog_info "Entering low power mode"

    # Write timestamp so poller/UI know when low power started
    date +%s > "$STATE_FILE"

    # Prevent watchdog from interfering during low power
    touch "$WATCHCAT_LOCK"

    # Disable modem radio
    qcmd 'AT+CFUN=0'

    qlog_info "Low power mode active — modem radio disabled"

elif [ "$1" = "exit" ]; then
    # No-op if not currently in low power mode (handles spurious cron fires)
    if [ ! -f "$STATE_FILE" ]; then
        exit 0
    fi

    qlog_info "Exiting low power mode"

    # Re-enable modem radio
    qcmd 'AT+CFUN=1'

    # Allow modem to settle
    sleep 3

    # Clean up state flags
    rm -f "$STATE_FILE"
    rm -f "$WATCHCAT_LOCK"

    qlog_info "Low power mode ended — modem radio restored"
fi

exit 0
